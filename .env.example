# Slack credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-level-token

# Optional: comma-separated list of allowed channels (leave empty for all)
ALLOWED_CHANNELS=

# MCP server configuration for accessibility knowledge base
ACCESSBRIDGE_MCP_COMMAND=node
ACCESSBRIDGE_MCP_ARGS=./scripts/mock-accessibility-mcp.js
ACCESSBRIDGE_MCP_TOOL=lookup_accessibility_term
ACCESSBRIDGE_MCP_ARG=term

# Set to true to simulate MCP responses without running a real MCP server
ACCESSBRIDGE_MOCK=false

# Optional: enable Slack Real-Time Search API to add workspace context to acronym explanations
ENABLE_SLACK_SEARCH=false

# AI-powered simplification via Google AI Studio (Gemini API).
# Get a free key at https://aistudio.google.com/apikey
# Set GEMINI_API_KEY to enable AI mode. Leave empty to use rule-based simplification.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=10000
