{
  "display_information": {
    "name": "AccessBridge",
    "description": "Plain language translator for people with disabilities",
    "background_color": "#2E7D32"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "AccessBridge",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Simplify this message",
        "type": "message",
        "callback_id": "simplify_message",
        "description": "Rewrite this message in plain language"
      },
      {
        "name": "Explain acronym",
        "type": "message",
        "callback_id": "explain_acronym",
        "description": "Explain an acronym from this message"
      }
    ],
    "slash_commands": [
      {
        "command": "/simplify",
        "description": "Simplify text to plain language",
        "usage_hint": "[paste text]",
        "should_escape": false
      },
      {
        "command": "/describe-image",
        "description": "Generate alt text for an attached image",
        "usage_hint": "[attach image]",
        "should_escape": false
      },
      {
        "command": "/structure-notes",
        "description": "Restructure meeting notes into decisions, actions, and context",
        "usage_hint": "[paste notes]",
        "should_escape": false
      },
      {
        "command": "/explain-acronym",
        "description": "Explain an accessibility or workplace acronym",
        "usage_hint": "[ACRONYM]",
        "should_escape": false
      },
      {
        "command": "/translate-jargon",
        "description": "Translate technical jargon into plain language",
        "usage_hint": "[paste text]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "commands",
        "files:read",
        "search:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false,
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "app_home_opened"
      ]
    },
    "interactivity": {
      "is_enabled": true
    }
  }
}
